FROM bitnami/java:21.0.7-9
WORKDIR /app
COPY ./target/DocuSeeAgent-2.3.0.jar DocuSeeAgent-2.3.0.jar
ARG SERVER_TYPE
ENV SERVER_TYPE=$SERVER_TYPE
ARG SERVER_MAIN_HOST
ENV SERVER_MAIN_HOST=$SERVER_MAIN_HOST
ARG SERVER_ADDR_CPU
ENV SERVER_ADDR_CPU=$SERVER_ADDR_CPU
ARG SERVER_ADDR_GPU
ENV SERVER_ADDR_GPU=$SERVER_ADDR_GPU
ARG SERVER_ADDR_IMG
ENV SERVER_ADDR_IMG=$SERVER_ADDR_IMG
ENV TZ=Asia/Seoul
CMD ["java", "-jar", "DocuSeeAgent-2.3.0.jar"]